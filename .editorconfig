root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.md]
# trailing double spaces are line breaks, and list continuations
# are indented to match their marker
trim_trailing_whitespace = false
indent_size = unset

[LICENSE]
indent_style = unset
indent_size = unset
